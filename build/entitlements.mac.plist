<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Allow the app to run on Apple Silicon and Intel via hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>

    <!-- Enforce library validation: only Apple-signed or app-signed code loads -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>

    <!-- Disallow DYLD environment variable injection -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <false/>

    <!-- No debugger attachment in production builds -->
    <key>com.apple.security.cs.debugger</key>
    <false/>

    <!-- Network access (required for update checks, if any) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- User-selected file access (for open/save panels) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
