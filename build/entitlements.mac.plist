<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for V8 JIT compilation under hardened runtime.
         Without this, Electron crashes at startup with
         "Failed to reserve virtual memory for CodeRange". -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Native modules (e.g. @journeyapps/sqlcipher) are not Apple-signed,
         so library validation must be relaxed to allow them to load. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Disallow DYLD environment variable injection -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <false/>

    <!-- No debugger attachment in production builds -->
    <key>com.apple.security.cs.debugger</key>
    <false/>

    <!-- Network access (required for update checks) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- User-selected file access (for open/save panels) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
